# Copy to .env and fill in. Never commit .env.

# --- Storage (Neon Postgres) ---
NEON_DATABASE_URL=

# --- APIs ---
TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HUNTER_API_KEY=

# --- Sending ---
# SEND_MODE: dry-run (default; nothing is sent) or live
SEND_MODE=dry-run
# SEND_TRANSPORT: gmail_api (OAuth, default; also enables reply/bounce tracking) or smtp (legacy app password)
SEND_TRANSPORT=gmail_api
# Gmail API OAuth client (Google Cloud console > APIs & Services > Credentials > OAuth client ID, type "Desktop app").
# Then run once:  python -m sprinto_agent gmail-auth   (you sign in yourself; the refresh token is stored in
# data/secrets/gmail_token.json, which is git-ignored and readable only by you)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional: Pub/Sub topic for push notifications (projects/<project>/topics/<topic>). Without it, the mailbox is
# polled every GMAIL_SYNC_MINUTES. The push endpoint is POST /gmail/push?token=<GMAIL_PUSH_TOKEN>.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_TOKEN=
GMAIL_SYNC_MINUTES=5
# Legacy SMTP (only used when SEND_TRANSPORT=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
# The ONLY address mail is ever sent to. Must be your own inbox.
OPERATOR_INBOX=
# Name used to sign drafts
SENDER_NAME=
# Days after a live send when a follow-up becomes due
FOLLOW_UP_DAYS=3

# --- Collection limits ---
USER_AGENT=SprintoProspectingResearch/0.1 (internal research; contact operator)
MAX_PAGES_PER_COMPANY=12
MAX_RESEARCH_ROUNDS=4
MAX_SEARCHES_PER_COMPANY=3
MAX_LLM_CALLS_PER_COMPANY=12
MAX_SECONDS_PER_COMPANY=180
# A run with no heartbeat for this long is treated as crashed ("interrupted") and can be resumed
STALE_RUN_MINUTES=15
# Set to 1 to block every send regardless of the in-app switch
SENDING_PAUSED=0
REQUEST_TIMEOUT_SECONDS=15
PER_HOST_DELAY_SECONDS=1.5
